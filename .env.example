# Template. Copy to .env and put your real key there — never in this file.
#   cp .env.example .env
#
# Get a key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-key-here

# Using DeepSeek through its Anthropic-compatible endpoint.
# To switch to Claude: set ANTHROPIC_API_KEY instead and remove the
# api_key/base_url arguments where the client is created.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional in development; required in any real deployment.
# DJANGO_SECRET_KEY=change-me

# Day 4 experiment: add N seconds to every LLM call to simulate a slow LLM.
# LLM_FAKE_DELAY=15
